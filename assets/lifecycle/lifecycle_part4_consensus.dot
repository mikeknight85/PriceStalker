digraph LifecyclePart4 {
  graph [label="Part 4 — Consensus, Arbitration & Price Guardrails", labelloc=t, rankdir=TB, bgcolor="#0f172a", fontname="Segoe UI", fontsize=20, fontcolor="#f8fafc", nodesep=.4, ranksep=.65, compound=true]
  node [shape=box, style="filled,rounded", fillcolor="#1e293b", color="#334155", fontcolor="#cbd5e1", fontname="Segoe UI", fontsize=10, penwidth=1.2]
  edge [color="#64748b", fontcolor="#94a3b8", fontname="Segoe UI", fontsize=9, arrowsize=.8]

  In [label="PriceCandidate[]", fillcolor="#2563eb", fontcolor="#ffffff"]
  Secondary [label="Separate member-price & original-price\nlargest group → memberPrice / originalPrice\n(secondary prices never stand in as standard)"]
  Sanity [label="Original-price sanity guardrail\ndiscard if < standard or > 10× standard"]
  Pref [label="Saved Troubleshoot Price preference\nmatches candidate this scrape?", shape=diamond, fillcolor="#d97706", fontcolor="#ffffff"]
  PrefWin [label="Preference honoured\noverrides standard consensus", fillcolor="#059669", fontcolor="#ffffff"]
  Deal [label="Any deal-price candidates?", shape=diamond, fillcolor="#d97706", fontcolor="#ffffff"]
  Pre [label="Any pre-order candidates?", shape=diamond, fillcolor="#d97706", fontcolor="#ffffff"]
  Weighted [label="Weighted standard arbitration\nexpert-* 5.0 | json-ld 2.0\ncustom-regex 1.6 | custom-css 1.5\ngeneric-css .2 | others 1.0"]
  HasConsensus [label="Consensus reached?\n(no equal-score tie)", shape=diamond, fillcolor="#d97706", fontcolor="#ffffff"]
  Resolved [label="Resolved standard price", fillcolor="#059669", fontcolor="#ffffff"]
  Arbitrate [label="Arbitration fallback:\n1. AI arbitration\n2. Nearest anchor price\n3. Top confidence (tie-break lowest price)", fillcolor="#92400e", fontcolor="#ffffff"]
  Currency [label="Currency resolved?", shape=diamond, fillcolor="#d97706", fontcolor="#ffffff"]
  Tie [label="Review required (no consensus / missing currency)\nneedsReview = true", fillcolor="#dc2626", fontcolor="#ffffff"]
  Stock [label="out_of_stock or not_available?", shape=diamond, fillcolor="#d97706", fontcolor="#ffffff"]
  Guard [label="Out-of-stock guardrails:\n• uncorroborated single JSON-LD\n• low-confidence method\n• extreme drift (<50% or >250% of anchor)", shape=diamond, fillcolor="#d97706", fontcolor="#ffffff"]
  Null [label="Nullify price\nneedsReview = true (oos_guardrail)", fillcolor="#dc2626", fontcolor="#ffffff"]
  Verify [label="Proceed to AI verification\nor persistence", fillcolor="#059669", fontcolor="#ffffff"]

  In -> Secondary -> Pref
  Pref -> PrefWin [label="yes"]
  Pref -> Deal [label="no match / none"]
  Deal -> HasConsensus [label="yes → deal priority"]
  Deal -> Pre [label="no"]
  Pre -> HasConsensus [label="yes → pre-order priority"]
  Pre -> Weighted [label="no"]
  Weighted -> HasConsensus
  HasConsensus -> Resolved [label="yes"]
  HasConsensus -> Arbitrate [label="no"]
  Arbitrate -> Resolved [label="price decided"]
  Arbitrate -> Tie [label="unresolved / flagged"]
  PrefWin -> Resolved
  Resolved -> Currency
  Currency -> Tie [label="no currency"]
  Currency -> Sanity [label="valid currency"]
  Sanity -> Stock
  Stock -> Verify [label="no (in stock)"]
  Stock -> Guard [label="yes (OOS)"]
  Guard -> Null [label="guard fails"]
  Guard -> Verify [label="passes"]
  Null -> Verify
  Tie -> Verify
}
