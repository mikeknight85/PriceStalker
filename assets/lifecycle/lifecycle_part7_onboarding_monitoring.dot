digraph LifecyclePart7 {
  graph [label="Part 7 — Product Onboarding & Monitoring State", labelloc=t, rankdir=TB, bgcolor="#0f172a", fontname="Segoe UI", fontsize=20, fontcolor="#f8fafc", nodesep=.5, ranksep=.75, compound=true]
  node [shape=box, style="filled,rounded", fillcolor="#1e293b", color="#334155", fontcolor="#cbd5e1", fontname="Segoe UI", fontsize=10, penwidth=1.2]
  edge [color="#64748b", fontcolor="#94a3b8", fontname="Segoe UI", fontsize=9, arrowsize=.8]

  URL [label="User submits product URL", fillcolor="#2563eb", fontcolor="#ffffff"]
  Discovery [label="Discovery scrape"]
  Clear [label="Clear price/status result?", shape=diamond, fillcolor="#d97706", fontcolor="#ffffff"]
  Active [label="Create product\nstart scheduled monitoring", fillcolor="#059669", fontcolor="#ffffff"]
  Review [label="No product row yet\nreturn review candidates", fillcolor="#db2777", fontcolor="#ffffff"]
  Confirm [label="User confirms candidate\ncreate and persist product", fillcolor="#db2777", fontcolor="#ffffff"]
  Monitor [label="Active monitoring\nnext_check_at due\n(max 3 concurrent; 30s domain gap)", fillcolor="#059669", fontcolor="#ffffff"]
  OOS [label="Stock transitions\nin_stock / out_of_stock / pre_order / member_only"]
  Gone [label="Result classification", shape=diamond, fillcolor="#d97706", fontcolor="#ffffff"]
  Streak [label="Three consecutive page-gone results?", shape=diamond, fillcolor="#d97706", fontcolor="#ffffff"]
  Paused [label="not_available\nauto_paused=true\nchecking_paused=true", fillcolor="#dc2626", fontcolor="#ffffff"]
  Manual [label="Manual/forced refresh\nwhile auto-paused", fillcolor="#92400e", fontcolor="#ffffff"]
  Restored [label="Page available again\nclear auto-pause, resume monitoring\nnotify product restored", fillcolor="#059669", fontcolor="#ffffff"]
  TransientStreak [label="Six consecutive transport failures?", shape=diamond, fillcolor="#d97706", fontcolor="#ffffff"]
  TransientNotify [label="Notify retailer unreachable\n(preserves stock status; continues checks)", fillcolor="#92400e", fontcolor="#ffffff"]
  Unknown [label="Transient error below threshold\npreserve known state; next due check"]

  URL -> Discovery -> Clear
  Clear -> Active [label="yes"]
  Clear -> Review [label="no"]
  Review -> Confirm -> Active
  Active -> Monitor
  Monitor -> OOS
  OOS -> Gone
  Gone -> Streak [label="definitive 404/gone"]
  Gone -> TransientStreak [label="transient transport error"]
  Streak -> Monitor [label="below threshold (<3)"]
  Streak -> Paused [label="threshold reached (3)"]
  TransientStreak -> TransientNotify [label="threshold reached (6)"]
  TransientStreak -> Unknown [label="below threshold (<6)"]
  TransientNotify -> Monitor
  Unknown -> Monitor
  Paused -> Manual
  Manual -> Restored [label="available"]
  Restored -> Monitor
  Manual -> Paused [label="still unavailable"]
}
